# LLM 제공자 선택: claude | zai
LLM_PROVIDER=zai

# Claude 설정 (API 키 또는 OAuth 중 택1)
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=
CLAUDE_MODEL=claude-sonnet-4-5
CLAUDE_MAX_TURNS=10
CLAUDE_PERMISSION_MODE=default
CLAUDE_CODE_NODE_PATH=
CLAUDE_CODE_CONFIG_DIR=

# Z.ai(GLM-4.7) 설정
ZAI_API_KEY=
ZAI_API_URL=https://api.z.ai/api/coding/paas/v4/chat/completions
ZAI_MODEL=glm-4.7

# 생성 결과 리뷰 설정
LLM_REVIEW_ENABLED=true
LLM_REVIEW_PROVIDER=zai
LLM_REVIEW_BLOCK_ON_FAIL=true
LLM_REVIEW_AUTO_FIX_ENABLED=true
LLM_REVIEW_AUTO_FIX_MAX_ATTEMPTS=1
ZAI_REVIEW_API_URL=
ZAI_REVIEW_MODEL=glm-4.7

LLM_LOGGING_ENABLED=true
