# LLM 제공자 선택: claude | zai
LLM_PROVIDER=zai

# Claude 설정 (API 키 또는 OAuth 중 택1)
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=
CLAUDE_MODEL=claude-sonnet-4-5
CLAUDE_MAX_TURNS=10
CLAUDE_PERMISSION_MODE=default
CLAUDE_CODE_NODE_PATH=
CLAUDE_CODE_CONFIG_DIR=

# Z.ai(GLM-5) 설정
ZAI_API_KEY=
ZAI_API_URL=https://api.z.ai/api/coding/paas/v4/chat/completions
ZAI_MODEL=glm-5

# 생성 결과 리뷰 설정
LLM_REVIEW_ENABLED=true
LLM_REVIEW_PROVIDER=zai
LLM_REVIEW_BLOCK_ON_FAIL=true
LLM_REVIEW_AUTO_FIX_ENABLED=true
LLM_REVIEW_AUTO_FIX_MAX_ATTEMPTS=1
ZAI_REVIEW_API_URL=
ZAI_REVIEW_MODEL=glm-5

LLM_LOGGING_ENABLED=true

# === Admin 서버 설정 ===
# Admin 서버 포트 (PORT보다 우선, 기본값: 3000)
ADMIN_PORT=3000
# WebSocket 활성화 (기본값: true, false로 비활성화 가능)
WS_ENABLED=true
# 프로젝트 루트 경로 (기본값: 자동 감지)
# PROJECT_ROOT=/path/to/art-assets

# === Job/Batch 저장 설정 ===
# Job 상태 저장 경로 (기본값: api/data/jobs.json)
# JOB_STORE_PATH=
# Job 만료 시간(ms), 0 이하면 만료 비활성화 (기본값: 604800000 = 7일)
# JOB_TTL_MS=604800000
# Batch 상태 저장 경로 (기본값: api/data/batches.json)
# BATCH_STORE_PATH=
# 비동기 Job 활성화 (기본값: true)
ASYNC_JOBS_ENABLED=true
